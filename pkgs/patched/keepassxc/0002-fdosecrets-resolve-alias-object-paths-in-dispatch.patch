index 5ec7499b1f..a2b1648fce 100644
--- a/src/fdosecrets/objects/Service.h
+++ b/src/fdosecrets/objects/Service.h
@@ -146,6 +146,8 @@ namespace FdoSecrets
     private:
         bool initialize();
 
+        friend class DBusMgr;
